#!/usr/bin/env bash
# Starts Home Assistant Core with this repo's custom_components mounted,
# so changes are picked up live (restart HA to reload, no reinstall needed).
set -e

export PYTHONPATH="${PYTHONPATH}:$(pwd)/custom_components"
mkdir -p config/custom_components
ln -sfn "$(pwd)/custom_components/honeywell_smileconnect" \
        config/custom_components/honeywell_smileconnect

hass --config config --debug
